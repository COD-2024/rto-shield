
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id            String   @id @default(cuid())
  shopifyId     String   @unique
  customerName  String?
  totalPrice    Float?
  riskScore     Int      @default(0)
  riskStatus    String   @default("Safe")
  riskReason    String?
  createdAt     DateTime @default(now())
}
